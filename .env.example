# Copy to .env only if your launcher loads environment files, or set these in PowerShell.
CUBE_CHESS_API_HOST=127.0.0.1
CUBE_CHESS_API_PORT=8000
CUBE_CHESS_DB=data/cube_chess.db
CUBE_CHESS_TOKEN_PEPPER=replace-with-a-long-random-local-secret
CUBE_CHESS_AGENT_PACE_MS=650
CUBE_CHESS_CORS_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:4174

# Choose either an in-process Python adapter or an HTTP model endpoint.
# CUBE_CHESS_GPU_AGENT_PLUGIN=my_agent:choose_move
# CUBE_CHESS_GPU_AGENT_URL=http://127.0.0.1:9000/choose-move
# CUBE_CHESS_GPU_AGENT_TOKEN=replace-with-model-endpoint-token
